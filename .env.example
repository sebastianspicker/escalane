# Core infrastructure
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://alarm:CHANGE_ME@postgres:5432/alarm
REDIS_URL=redis://redis:6379/0
BASE_URL=http://localhost:8080
LOG_LEVEL=INFO

# Yealink-compatible device intake
YELK_TOKEN_QUERY_PARAM=token
# Used by deploy/seed.example.yaml; set a long random value before importing it.
YEALINK_DEVICE_TOKEN=
# Comma-separated source CIDRs. Required outside simulation.
YELK_IP_ALLOWLIST=
RATE_LIMIT_PER_MINUTE=10

# Administration and proxy trust
ADMIN_API_KEY=
ENABLE_API_DOCS=false
# Comma-separated CIDRs for proxies allowed to supply forwarded headers.
TRUSTED_PROXY_CIDRS=

# Zammad
ZAMMAD_BASE_URL=https://zammad.example.org
ZAMMAD_API_TOKEN=
ZAMMAD_GROUP=Emergency Desk
ZAMMAD_PRIORITY_ID_P0=3
ZAMMAD_STATE_ID_NEW=1
ZAMMAD_CUSTOMER=guess:alarm-system@your-domain.de

# SendXMS-compatible SMS
SENDXMS_ENABLED=false
SENDXMS_BASE_URL=https://api.sendxms.tld
SENDXMS_API_KEY=
SENDXMS_FROM=Alarm
SENDXMS_SEND_PATH=/send

# Signal REST bridge
SIGNAL_ENABLED=false
SIGNAL_CLI_ENDPOINT=http://signal-cli:8080
SIGNAL_TARGET_GROUP_ID=
SIGNAL_SEND_PATH=/v2/send

# Signed callbacks and generic webhook targets
WEBHOOK_ENABLED=false
WEBHOOK_URL=
# Comma-separated exact hosts; an empty value disables webhook egress.
WEBHOOK_ALLOWED_HOSTS=
# At least 32 characters when callbacks are enabled.
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_SECONDS=5

# Escalation delays in seconds; zero disables a step.
ESCALATE_T1=60
ESCALATE_T2=180
ESCALATE_T3=300

# Database pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
# Milliseconds; zero disables slow-query logging.
SLOW_QUERY_LOG_MS=200

# Local mock delivery. BASE_URL must resolve to loopback when enabled.
SIMULATION_ENABLED=false
